{
	"name": "@nature-urbaine/database",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/config.ts",
		"./types": "./src/payload-types.ts",
		"./utils/lexical": "./src/utils/lexical.ts"
	},
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "oxfmt --check && oxlint",
		"typecheck": "tsc --noEmit",
		"seed:dev": "NODE_ENV=development PAYLOAD_DROP_DATABASE=true payload run ./src/seed/index.ts",
		"seed:prod": "NODE_ENV=production payload run ./src/seed/index.ts",
		"seed:update": "PAYLOAD_CONFIG_PATH=./src/default-config.ts payload run ./src/seed/update.ts",
		"storage:check": "PAYLOAD_CONFIG_PATH=./src/read-config.ts payload run ./src/scripts/check-storage.ts",
		"storage:fixtures:large-report": "PAYLOAD_CONFIG_PATH=./src/read-config.ts payload run ./src/scripts/large-report-fixture.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1153.0",
		"@payloadcms/db-postgres": "4.0.0-beta.3",
		"@payloadcms/email-nodemailer": "4.0.0-beta.3",
		"@payloadcms/richtext-lexical": "4.0.0-beta.3",
		"@payloadcms/storage-s3": "4.0.0-beta.3",
		"@payloadcms/transformer-sharp": "4.0.0-beta.3",
		"@payloadcms/translations": "4.0.0-beta.3",
		"@types/jsdom": "^28.0.3",
		"graphql": "^16.14.2",
		"jsdom": "^27.4.0",
		"payload": "4.0.0-beta.3",
		"pg": "^8.23.1",
		"sharp": "0.35.4",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"typescript": "^6.0.3"
	}
}
