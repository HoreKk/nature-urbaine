{
	"name": "nature-urbaine",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"dev:emails": "email dev --dir src/emails/previews --port 4000",
		"build": "payload build",
		"start": "node .output/server/index.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "oxfmt --check && oxlint",
		"postinstall": "chakra typegen src/utils/chakra-theme.ts --tsconfig tsconfig.json",
		"chakra:typegen": "chakra typegen src/utils/chakra-theme.ts --tsconfig tsconfig.json",
		"chakra:typegen:watch": "chakra typegen src/utils/chakra-theme.ts --tsconfig tsconfig.json --watch",
		"generate:importmap": "payload generate:importmap",
		"generate:types": "payload generate:types",
		"generate:db-schema": "payload generate:db-schema",
		"migrate": "payload migrate",
		"migrate:create": "payload migrate:create",
		"migrate:status": "payload migrate:status",
		"migrate:down": "payload migrate:down",
		"migrate:refresh": "payload migrate:refresh",
		"migrate:reset": "payload migrate:reset",
		"migrate:fresh": "payload migrate:fresh",
		"db:push": "NODE_ENV=development PAYLOAD_CONFIG_PATH=./src/payload/default-config.ts payload run ./src/payload/scripts/db-push.ts",
		"seed:dev": "NODE_ENV=development PAYLOAD_DROP_DATABASE=true PAYLOAD_CONFIG_PATH=./src/payload/default-config.ts payload run ./src/payload/seed/index.ts",
		"storage:check": "PAYLOAD_CONFIG_PATH=./src/payload/read-config.ts payload run ./src/payload/scripts/check-storage.ts",
		"storage:fixtures:large-report": "PAYLOAD_CONFIG_PATH=./src/payload/read-config.ts payload run ./src/payload/scripts/large-report-fixture.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1166.0",
		"@aws-sdk/s3-request-presigner": "^3.1166.0",
		"@chakra-ui/react": "^3.38.0",
		"@emotion/react": "^11.14.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource-variable/roboto-mono": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@payloadcms/db-postgres": "4.0.0-beta.8",
		"@payloadcms/email-nodemailer": "4.0.0-beta.8",
		"@payloadcms/email-resend": "4.0.0-beta.8",
		"@payloadcms/richtext-lexical": "4.0.0-beta.8",
		"@payloadcms/storage-s3": "4.0.0-beta.8",
		"@payloadcms/tanstack-start": "4.0.0-beta.8",
		"@payloadcms/transformer-sharp": "4.0.0-beta.8",
		"@payloadcms/translations": "4.0.0-beta.8",
		"@payloadcms/ui": "4.0.0-beta.8",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.5",
		"@tanstack/router-plugin": "^1.169.0",
		"@uidotdev/usehooks": "^2.4.1",
		"exifreader": "^4.54.0",
		"fflate": "^0.8.3",
		"graphql": "^16.14.2",
		"nodemailer": "10.5.0",
		"payload": "4.0.0-beta.8",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-email": "^6.11.11",
		"react-icons": "^5.7.0",
		"sharp": "0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@chakra-ui/cli": "^3.38.0",
		"@react-email/ui": "^6.11.11",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitejs/plugin-rsc": "^0.5.39",
		"jsdom": "^28.1.0",
		"lefthook": "^2.2.2",
		"nitro": "3.0.261103-rc",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"xlsx": "^0.18.5"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@10.28.2"
}
