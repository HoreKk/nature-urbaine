{
	"name": "nature-urbaine",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"scripts": {
		"migrate": "pnpm --filter website migrate",
		"migrate:create": "pnpm --filter website migrate:create",
		"migrate:status": "pnpm --filter website migrate:status",
		"migrate:down": "pnpm --filter website migrate:down",
		"migrate:refresh": "pnpm --filter website migrate:refresh",
		"migrate:reset": "pnpm --filter website migrate:reset",
		"migrate:fresh": "pnpm --filter website migrate:fresh",
		"generate:types": "pnpm --filter website generate:types",
		"generate:importmap": "pnpm --filter website generate:importmap",
		"seed:dev": "pnpm --filter @nature-urbaine/database seed:dev",
		"seed:prod": "pnpm --filter @nature-urbaine/database seed:prod",
		"seed:update": "pnpm --filter @nature-urbaine/database seed:update",
		"storage:check": "pnpm --filter @nature-urbaine/database storage:check",
		"dev:website": "cd apps/website && pnpm dev",
		"dev:emails": "pnpm --filter @nature-urbaine/emails dev",
		"chakra:typegen": "pnpm --filter website chakra:typegen",
		"chakra:typegen:watch": "pnpm --filter website chakra:typegen:watch",
		"build": "pnpm --filter website build",
		"build:loose": "turbo build --env-mode=loose",
		"start": "node apps/website/.output/server/index.mjs",
		"serve:web": "cd apps/website && pnpm start",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "oxfmt --check && oxlint"
	},
	"devDependencies": {
		"lefthook": "^2.1.6",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.61.0",
		"turbo": "^2.9.10"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@10.28.2"
}
