{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"react",
		"react-perf",
		"unicorn",
		"jsx-a11y",
		"oxc",
		"promise"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"react/react-in-jsx-scope": "off",
		"no-underscore-dangle": [
			"warn",
			{
				"allow": ["_objectKey"]
			}
		]
	},
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.next/**",
		"**/.output/**",
		"**/.turbo/**",
		"src/app/_payload.tsx",
		"src/app/_payload/**",
		"src/routeTree.gen.ts",
		"src/components/ui/**",
		"src/payload/migrations/**",
		"src/payload/payload-types.ts",
		"src/payload/payload-generated-schema.ts"
	],
	"overrides": [
		{
			"files": ["src/components/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["@/payload", "@/payload/**", "payload", "payload/**"],
								"allowTypeImports": true,
								"message": "Components ship to the browser: only `import type` from Payload code."
							}
						]
					}
				]
			}
		}
	]
}
