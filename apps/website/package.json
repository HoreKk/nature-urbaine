{
	"name": "website",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "payload build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "oxfmt --check && oxlint",
		"start": "srvx --prod --dir=. --static=dist/client --entry=dist/server/server.js",
		"check-types": "tsc --noEmit",
		"chakra:typegen": "chakra typegen src/utils/chakra-theme.ts --tsconfig tsconfig.json",
		"chakra:typegen:watch": "chakra typegen src/utils/chakra-theme.ts --tsconfig tsconfig.json --watch",
		"postinstall": "chakra typegen src/utils/chakra-theme.ts --tsconfig tsconfig.json",
		"generate:importmap": "payload generate:importmap",
		"generate:types": "payload generate:types",
		"migrate": "payload migrate",
		"migrate:create": "payload migrate:create",
		"migrate:status": "payload migrate:status",
		"migrate:down": "payload migrate:down",
		"migrate:refresh": "payload migrate:refresh",
		"migrate:reset": "payload migrate:reset",
		"migrate:fresh": "payload migrate:fresh"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1037.0",
		"@aws-sdk/s3-request-presigner": "^3.1037.0",
		"@chakra-ui/react": "^3.35.0",
		"@emotion/react": "^11.14.0",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/newsreader": "^5.2.10",
		"@fontsource/instrument-sans": "^5.2.8",
		"@nature-urbaine/database": "workspace:*",
		"@nature-urbaine/emails": "workspace:*",
		"@payloadcms/db-postgres": "4.0.0-beta.2",
		"@payloadcms/email-nodemailer": "4.0.0-beta.2",
		"@payloadcms/graphql": "4.0.0-beta.2",
		"@payloadcms/richtext-lexical": "4.0.0-beta.2",
		"@payloadcms/storage-s3": "4.0.0-beta.2",
		"@payloadcms/tanstack-start": "4.0.0-beta.2",
		"@payloadcms/transformer-sharp": "4.0.0-beta.2",
		"@payloadcms/ui": "4.0.0-beta.2",
		"@tanstack/react-form": "^1.32.0",
		"@tanstack/react-query": "^5.104.4",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.3",
		"@tanstack/router-plugin": "^1.168.47",
		"@uidotdev/usehooks": "^2.4.1",
		"graphql": "^16.12.0",
		"nodemailer": "10.1.2",
		"payload": "4.0.0-beta.2",
		"pg": "^8.20.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-icons": "^5.5.0",
		"sharp": "^0.34.5",
		"srvx": "0.11.21",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@chakra-ui/cli": "^3.35.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.2.0",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitejs/plugin-rsc": "^0.5.38",
		"jsdom": "^27.0.0",
		"nitro": "3.0.260903-beta",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"vitest": "^3.0.5",
		"web-vitals": "^5.1.0"
	},
	"engines": {
		"node": ">=24.15.0"
	}
}
