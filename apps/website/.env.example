PAYLOAD_SECRET=xxx
DATABASE_URL="postgresql://postgres:password@localhost:5434/nature-urbaine"
BACKEND_URL=http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# Email configuration
TO_EMAIL=contact@nature-urbaine.fr
EMAIL_FROM=no-reply@nature-urbaine.fr
CONTACT_EMAIL_TO=contact@nature-urbaine.fr
CONTACT_EMAIL_FROM=no-reply@nature-urbaine.fr
CONTACT_EMAIL_FROM_NAME="Nature Urbaine"

# SMTP configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Railway bucket (same names as the CMS). When set, the website signs bucket
# URLs itself so images never go through the CMS. Map them with Railway
# reference variables, e.g. S3_BUCKET=${{Bucket.BUCKET}},
# S3_ENDPOINT=${{Bucket.ENDPOINT}}, S3_ACCESS_KEY=${{Bucket.ACCESS_KEY_ID}},
# S3_SECRET_KEY=${{Bucket.SECRET_ACCESS_KEY}}, S3_REGION=${{Bucket.REGION}}.
# Leave unset locally: images then load through BACKEND_URL as before.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
