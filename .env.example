PAYLOAD_SECRET=xxx
DATABASE_URL="postgresql://postgres:password@localhost:5434/nature-urbaine"

# Email configuration
# Contact and submission forms both send from EMAIL_FROM_NAME <EMAIL_FROM>
# to every TO_EMAIL address (comma-separated).
TO_EMAIL=contact@nature-urbaine.com
EMAIL_FROM=no-reply@nature-urbaine.com
EMAIL_FROM_NAME="Nature Urbaine"

# Resend (production). When set, it wins over SMTP: Railway blocks SMTP below
# Pro. EMAIL_FROM must be on the domain verified in Resend.
RESEND_API_KEY=

# SMTP configuration (local mail catcher)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Railway bucket (same names Payload uses). When set, the website signs bucket
# URLs itself so images never go through the Node process. Map them with Railway
# reference variables, e.g. S3_BUCKET=${{Bucket.BUCKET}},
# S3_ENDPOINT=${{Bucket.ENDPOINT}}, S3_ACCESS_KEY=${{Bucket.ACCESS_KEY_ID}},
# S3_SECRET_KEY=${{Bucket.SECRET_ACCESS_KEY}}, S3_REGION=${{Bucket.REGION}}.
# Locally they point at the RustFS store from docker-compose.yaml (bucket
# created on first `docker compose up`). Leave them empty to store uploads on
# disk instead (media/, pictures/).
S3_BUCKET=nature-urbaine
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=rustfs
S3_SECRET_KEY=rustfs-dev-secret
S3_REGION=us-east-1

# Umami analytics (self-hosted on Railway). The tracker and the admin dashboard
# widget both stay off until these are set. VITE_* values are baked into the
# client bundle at build time, so they must be set on the Railway service before
# it builds. UMAMI_API_KEY (Umami > Settings > API keys) stays on the server.
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
